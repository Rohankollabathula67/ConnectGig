rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — only the user themselves can read/write their own folder
    match /users/{uid}/profile/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024   // max 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Service request photos — client who created the request can upload
    match /requests/{requestId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // max 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Provider ID documents — only the provider themselves can upload
    match /providers/{uid}/documents/{fileName} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Chat image attachments — authenticated participants
    match /chats/{conversationId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // max 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
