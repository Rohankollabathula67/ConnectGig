# ConnectGig — Environment Variables
# Copy this file to .env and fill in your real values from:
# Firebase Console → Project Settings → General → Your apps → SDK setup and configuration

# ─── Firebase Web SDK Config ───────────────────────────────────────────────────
# From: Firebase Console → Project Settings → General → Web app → Config object
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Google Maps SDK ───────────────────────────────────────────────────────────
# From: Google Cloud Console → APIs & Services → Credentials → Maps SDK Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Razorpay Payment Gateway ──────────────────────────────────────────────────
# From: Razorpay Dashboard → Settings → API Keys → Key ID
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# ─── Notes ─────────────────────────────────────────────────────────────────────
# 1. All EXPO_PUBLIC_ vars are bundled into the client app — never put secrets here.
# 2. google-services.json  → place at: android/google-services.json
#    GoogleService-Info.plist → place at: ios/GoogleService-Info.plist
# 3. For EAS builds, also set these in your EAS secret environment variables:
#    https://docs.expo.dev/eas/environment-variables/
